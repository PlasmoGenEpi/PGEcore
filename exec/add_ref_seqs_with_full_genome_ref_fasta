#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    "--ref_bed",
    help = paste(
      "a bed file containing the reference location of the ref_seq, no column",
      "names but the first 6 columns should be chrom, start, end, target_name,",
      "length, strand"
    )
  ),
  make_option(
    "--genome_fasta",
    help = "a genome fasta file to extract the ref_seq"
  ),
  make_option(
    "--out",
    help = "the out file to write to"
  ),
  make_option(
    "--overwrite",
    help = "overwrite the output if it already exists",
    action = "store_true",
    default = FALSE,
    type = "logical"
  )
)

arg <- parse_args(OptionParser(option_list = opts))
missing <- character()
if (is.null(arg$ref_bed)) {
  missing <- c(missing, "--ref_bed")
}
if (is.null(arg$genome_fasta)) {
  missing <- c(missing, "--genome_fasta")
}
if (is.null(arg$out)) {
  missing <- c(missing, "--out")
}
if (length(missing) > 0) {
  stop(
    "Missing the following arguments: ",
    paste(missing, collapse = ", "),
    call. = FALSE
  )
}

invisible(
  add_ref_seqs_with_full_genome_ref_fasta(
    ref_bed = arg$ref_bed,
    genome_fasta = arg$genome_fasta,
    out = arg$out,
    overwrite = isTRUE(arg$overwrite)
  )
)
