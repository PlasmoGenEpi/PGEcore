#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    "--snp_calls",
    help = "SNP calls TSV (specimen_name, target_name, chrom, pos, snp_name, ref_base, seq_base, reads, is_biallelic). See vignette input-formats."
  ),
  make_option(
    "--snp_calls_output",
    help = "Filtered SNP calls TSV output (includes he)."
  ),
  make_option(
    "--mindist_between_snps",
    type = "integer",
    default = 10000,
    help = "the minimum distance between SNPs to consider them 'independent'. Default: %default"
  ),
  make_option(
    "--select_target_names",
    help = "only process these targets"
  ),
  make_option(
    "--select_specimen_names",
    help = "only process these samples"
  ),
  make_option(
    "--overwrite",
    help = "overwrite the output fnp if it already exists. Default: %default",
    action = "store_true",
    default = FALSE,
    type = "logical"
  ),
  make_option(
    "--only_biallelic",
    help = "filter to only biallelic SNPs too. Default: %default",
    action = "store_true",
    default = FALSE,
    type = "logical"
  ),
  make_option(
    "--only_informative",
    help = "filter off SNPs with no variation. Default: %default",
    action = "store_true",
    default = FALSE,
    type = "logical"
  ),
  make_option(
    "--exclude_snp_names",
    help = "SNPs to drop before ranking (comma-separated or one-column TSV)"
  ),
  make_option(
    "--drop_artifact_snps",
    help = "drop SNPs whose minor allele recurs in otherwise-monoclonal specimens (e.g. PCR stutter). Default: %default",
    action = "store_true",
    default = FALSE,
    type = "logical"
  ),
  make_option(
    "--artifact_min_minor_rate",
    type = "double",
    default = 0.02,
    help = "min share of otherwise-monoclonal specimens showing the minor allele to drop a SNP. Default: %default"
  ),
  make_option(
    "--artifact_min_samples",
    type = "integer",
    default = 3,
    help = "min number of those specimens showing it. Default: %default"
  ),
  make_option(
    "--dropped_snps_output",
    help = "write the names of dropped SNPs here, one per line"
  )
)

arg <- parse_args(OptionParser(option_list = opts))
if (is.null(arg$snp_calls) || is.null(arg$snp_calls_output)) {
  stop(
    "Missing required arguments: --snp_calls and --snp_calls_output",
    call. = FALSE
  )
}

invisible(
  filter_to_highest_diversity_independent_snp_call(
    snp_calls = arg$snp_calls,
    snp_calls_output = arg$snp_calls_output,
    mindist_between_snps = arg$mindist_between_snps,
    select_target_names = arg$select_target_names,
    select_specimen_names = arg$select_specimen_names,
    overwrite = isTRUE(arg$overwrite),
    only_biallelic = isTRUE(arg$only_biallelic),
    only_informative = isTRUE(arg$only_informative),
    exclude_snp_names = arg$exclude_snp_names,
    drop_artifact_snps = isTRUE(arg$drop_artifact_snps),
    artifact_min_minor_rate = arg$artifact_min_minor_rate,
    artifact_min_samples = arg$artifact_min_samples,
    dropped_snps_output = arg$dropped_snps_output
  )
)
