#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    "--aa_calls",
    type = "character",
    help = "AA calls TSV (specimen_name, gene_id, aa_position, aa, reads). See vignette input-formats."
  ),
  make_option(
    "--output",
    type = "character",
    help = "Filtered AA calls TSV output."
  ),
  make_option(
    "--min_reads",
    type = "integer",
    help = "Keep calls with at least this many reads. Unset: no read-count filter."
  ),
  make_option(
    "--min_wsaf",
    type = "double",
    help = "Keep calls with within-sample allele frequency at least this value (0-1). Unset: no WSAF filter."
  ),
  make_option(
    "--overwrite",
    help = "overwrite the output if it already exists",
    action = "store_true",
    default = FALSE,
    type = "logical"
  )
)

arg <- parse_args(OptionParser(option_list = opts))
if (is.null(arg$aa_calls) || is.null(arg$output)) {
  stop(
    "Missing required arguments: --aa_calls and --output",
    call. = FALSE
  )
}

min_reads <- arg$min_reads
if (length(min_reads) == 0L || (length(min_reads) == 1L && is.na(min_reads))) {
  min_reads <- NULL
}
min_wsaf <- arg$min_wsaf
if (length(min_wsaf) == 0L || (length(min_wsaf) == 1L && is.na(min_wsaf))) {
  min_wsaf <- NULL
}

invisible(
  filter_aa_calls(
    aa_calls = arg$aa_calls,
    output = arg$output,
    min_reads = min_reads,
    min_wsaf = min_wsaf,
    overwrite = isTRUE(arg$overwrite)
  )
)
