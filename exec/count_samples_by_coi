#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    c("-i", "--coi_table"),
    help = "COI table TSV (specimen_name, coi). See vignette input-formats.",
    type = "character",
    default = NULL,
    callback = function(opt, flag_string, value, parser, ...) {
      if (!file.exists(value)) {
        stop(paste0(value, " does not exist"), call. = FALSE)
      }
      value
    }
  ),
  make_option(
    c("-o", "--output"),
    help = "Output TSV (coi, n, proportion). Default: %default",
    type = "character",
    default = "coi_distribution.tsv"
  )
)

args <- parse_args(OptionParser(option_list = opts))
if (is.null(args$coi_table)) {
  stop("Missing required arguments: --coi_table", call. = FALSE)
}

invisible(count_samples_by_coi(coi_table = args$coi_table, output = args$output))
