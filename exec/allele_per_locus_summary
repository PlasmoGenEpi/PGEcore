#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    "--allele_table",
    help = paste0(
      "TSV containing allele present/absent per specimen, with the ",
      "columns: specimen_name, target_name, seq"
    )
  ),
  make_option(
    "--output",
    default = "allele_summary_by_target.tsv",
    help = paste0(
      "Output TSV path for the per-locus allele summary. ",
      "Default: allele_summary_by_target.tsv"
    )
  )
)

arg <- parse_args(OptionParser(option_list = opts))
if (is.null(arg$allele_table) ||
    (length(arg$allele_table) == 1L && is.na(arg$allele_table))) {
  stop("Missing required arguments: --allele_table", call. = FALSE)
}

invisible(
  allele_per_locus_summary(
    allele_table = arg$allele_table,
    output = arg$output
  )
)
