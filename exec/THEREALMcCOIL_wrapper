#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    "--snp_calls",
    type = "character",
    help = paste0(
      "TSV containing snp calls, with at least the following columns: ",
      "specimen_name, target_name, snp_name, pos, seq_base, reads, he. ",
      "Required"
    )
  ),
  make_option(
    "--model",
    type = "character",
    default = "categorical",
    help = paste0(
      "categorial or proprotional. ",
      "The `categorical` one models heterozygous/homozygous calls; ",
      "the `proportional` one models frequency data",
      "Default: %default"
    )
  ),
  make_option(
    "--maxCOI",
    type = "integer",
    default = 25,
    help = paste0(
      "Upper bound for COI. ",
      "Can be used in both models. ",
      "Default: %default"
    )
  ),
  make_option(
    "--threshold_ind",
    type = "integer",
    default = 20,
    help = paste0(
      "The minimum number of sites for a sample to be considered. ",
      "Used only in the categorical model. ",
      "Default: %default"
    )
  ),
  make_option(
    "--threshold_site",
    type = "integer",
    default = 20,
    help = paste0(
      "The minimum number of samples for a locus to be considered. ",
      "Used only in the categorical model. ",
      "Default: %default"
    )
  ),
  make_option(
    "--totalrun",
    type = "integer",
    default = 10000,
    help = paste0(
      "The total number of MCMC iterations. ",
      "Can be used in both models. ",
      "Default: %default"
    )
  ),
  make_option(
    "--burnin",
    type = "integer",
    default = 1000,
    help = paste0(
      "The total number of burnin iterations",
      "Can be used in both models. ",
      "Default: %default"
    )
  ),
  make_option(
    "--M0",
    type = "integer",
    default = 15,
    help = paste0(
      "Initial COI",
      "Can be used in both models. ",
      "Default: %default"
    )
  ),
  make_option(
    "--e1",
    type = "double",
    default = 0.05,
    help = paste0(
      "The probability of calling homozygous loci heterozygous. ",
      "Used only in the categorical model. ",
      "Default: %default"
    )
  ),
  make_option(
    "--e2",
    type = "double",
    default = 0.05,
    help = paste0(
      "The probability of calling heterozygous loci homozygous",
      "Used only in the categorical model. ",
      "Default: %default"
    )
  ),
  make_option(
    "--epsilon",
    type = "double",
    default = 0.02,
    help = "[P] Default: %default"
  ),
  make_option(
    "--err_method",
    type = "integer",
    default = 1,
    help = paste0(
      "1: use pre-specified e1 and e2 and treat them as constants; ",
      "3: e1 and e2 are estimated with COI and allele frequencies",
      "Can be used in both models. ",
      "Default: %default"
    )
  ),
  make_option(
    "--seed",
    type = "integer",
    default = 321,
    help = paste0(
      "Random seed for the first chain; chain i uses seed + i - 1. ",
      "Can be used in both models. ",
      "Default: %default"
    )
  ),
  make_option(
    "--n_chains",
    type = "integer",
    default = 3,
    help = paste0(
      "Number of independent MCMC chains to run (in parallel, one per core). ",
      "Multiple chains are required to compute the Gelman-Rubin R-hat ",
      "convergence diagnostic. Can be used in both models. ",
      "Default: %default"
    )
  ),
  make_option(
    "--slaf_output",
    type = "character",
    help = paste0(
      "Output TSV containing single locus allele frequencies, with the ",
      "columns: variant, freq. ",
      "Required"
    )
  ),
  make_option(
    "--coi_output",
    type = "character",
    help = paste0(
      "Output TSV containing single locus allele frequencies, with the ",
      "columns: variant, freq. ",
      "Required"
    )
  ),
  make_option(
    "--convergence_output",
    type = "character",
    default = "convergence_diag.tsv",
    help = paste0(
      "Output TSV containing MCMC convergence diagnostics, with one row per ",
      "parameter (coi per specimen, freq per locus, and error parameters ",
      "when --err_method 3) and the columns: variable, mean, median, sd, q5, ",
      "q95, rhat, ess_bulk, ess_tail. ",
      "Default: %default"
    )
  )
)

arg <- parse_args(OptionParser(option_list = opts))
if (is.null(arg$snp_calls) || !nzchar(arg$snp_calls)) {
  stop("--snp_calls must be set", call. = FALSE)
}
if (is.null(arg$slaf_output) || !nzchar(arg$slaf_output)) {
  stop("--slaf_output must be set", call. = FALSE)
}
if (is.null(arg$coi_output) || !nzchar(arg$coi_output)) {
  stop("--coi_output must be set", call. = FALSE)
}

invisible(
  THEREALMcCOIL_wrapper(
    snp_calls = arg$snp_calls,
    slaf_output = arg$slaf_output,
    coi_output = arg$coi_output,
    model = arg$model,
    maxCOI = arg$maxCOI,
    threshold_ind = arg$threshold_ind,
    threshold_site = arg$threshold_site,
    totalrun = arg$totalrun,
    burnin = arg$burnin,
    M0 = arg$M0,
    e1 = arg$e1,
    e2 = arg$e2,
    epsilon = arg$epsilon,
    err_method = arg$err_method,
    seed = arg$seed,
    n_chains = arg$n_chains,
    convergence_output = arg$convergence_output
  )
)
