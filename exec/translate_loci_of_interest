#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    "--allele_table",
    help = paste(
      "TSV containing the columns: specimen_name, target_name, reads, seq"
    )
  ),
  make_option(
    "--ref_bed",
    help = paste(
      "a bed file containing the reference location of the ref_seq, no column",
      "names but the first 6 columns should be chrom, start, end, target_name,",
      "length, strand, ref_seq"
    )
  ),
  make_option(
    "--loci_of_interest",
    help = paste(
      "a bed file containing the loci of interest to translate, is genomic",
      "location of the codon position so all loci should be of size 3, should",
      "correspond to the same, should have columns, #chrom, start, end, name,",
      "length, strand, gene, gene_id, aa_position"
    )
  ),
  make_option(
    "--output_directory",
    help = "the output directory to write results to"
  ),
  make_option(
    "--select_target_names",
    help = "only process these targets"
  ),
  make_option(
    "--select_specimen_names",
    help = "only process these samples"
  ),
  make_option(
    "--overwrite_dir",
    help = "overwrite the output directory if it already exists",
    action = "store_true",
    default = FALSE,
    type = "logical"
  ),
  make_option(
    "--output_stop_codons",
    help = paste(
      "If FALSE, calls containing * will be treated as untranslatable. These",
      "calls can appear in MIP data."
    ),
    action = "store_true",
    default = FALSE,
    type = "logical"
  ),
  make_option(
    "--collapse_calls_by_summing",
    help = paste(
      "collapse amino acid calls by summing across targets, by default the",
      "target with the highest read count will be used as the final call"
    ),
    action = "store_true",
    default = FALSE,
    type = "logical"
  )
)

arg <- parse_args(OptionParser(option_list = opts))
missing <- character()
if (is.null(arg$allele_table)) missing <- c(missing, "--allele_table")
if (is.null(arg$ref_bed)) missing <- c(missing, "--ref_bed")
if (is.null(arg$loci_of_interest)) missing <- c(missing, "--loci_of_interest")
if (is.null(arg$output_directory)) missing <- c(missing, "--output_directory")
if (length(missing) > 0) {
  stop("Missing required arguments: ", paste(missing, collapse = ", "), call. = FALSE)
}

invisible(
  translate_loci_of_interest(
    allele_table = arg$allele_table,
    ref_bed = arg$ref_bed,
    loci_of_interest = arg$loci_of_interest,
    output_directory = arg$output_directory,
    select_target_names = arg$select_target_names,
    select_specimen_names = arg$select_specimen_names,
    overwrite_dir = isTRUE(arg$overwrite_dir),
    output_stop_codons = isTRUE(arg$output_stop_codons),
    collapse_calls_by_summing = isTRUE(arg$collapse_calls_by_summing)
  )
)
