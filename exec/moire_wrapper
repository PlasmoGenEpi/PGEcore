#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(optparse)
  library(PGEcore)
})

opts <- list(
  make_option(
    "--allele_table",
    help = paste0(
      "TSV containing allele present/absent per specimen, with the ",
      "columns: specimen_name, target_name, seq"
    )
  ),
  make_option(
    "--allow_relatedness",
    type = "logical",
    default = TRUE,
    help = paste0(
      "Logical flag to allow relatedness within samples. ",
      "Set to TRUE by default"
    )
  ),
  make_option(
    "--burnin",
    type = "integer",
    default = 10000,
    help = paste0(
      "Number of burn-in iterations for the MCMC sampler. ",
      "Default is set to 10000 iterations."
    )
  ),
  make_option(
    "--samples_per_chain",
    type = "integer",
    default = 1000,
    help = paste0(
      "Number of samples per chain for the MCMC sampler. ",
      "Default is set to 1000 samples."
    )
  ),
  make_option(
    "--num_chains",
    type = "integer",
    default = 3,
    help = paste0(
      "Number of independent MCMC chains to run. Multiple chains are required ",
      "to compute the Gelman-Rubin R-hat convergence diagnostic. Note this is ",
      "distinct from --pt_chains (parallel tempering rungs within a chain). ",
      "Default set to 3."
    )
  ),
  make_option(
    "--chains_num_threads",
    type = "integer",
    default = 1,
    help = paste0(
      "Number of threads used to run the independent chains in parallel ",
      "(moire's num_cores). Default set to 1."
    )
  ),
  make_option(
    "--thin",
    type = "integer",
    default = 1,
    help = paste0(
      "Thinning interval for the MCMC sampler; only every thin-th sample is ",
      "retained. Default is set to 1 (no thinning)."
    )
  ),
  make_option(
    "--verbose",
    type = "logical",
    default = FALSE,
    help = paste0(
      "Logical flag to enable verbose output during processing. ",
      "Set to FALSE by default."
    )
  ),
  make_option(
    "--eps_pos_alpha",
    type = "integer",
    default = 1,
    help = "Alpha parameter for the positive error rate prior. Default set to 1."
  ),
  make_option(
    "--eps_pos_beta",
    type = "integer",
    default = 1,
    help = "Beta parameter for the positive error rate prior. Default set to 1."
  ),
  make_option(
    "--eps_neg_alpha",
    type = "integer",
    default = 1,
    help = "Alpha parameter for the negative error rate prior. Default set to 1."
  ),
  make_option(
    "--eps_neg_beta",
    type = "integer",
    default = 1,
    help = "Beta parameter for the negative error rate prior. Default set to 1."
  ),
  make_option(
    "--r_alpha",
    type = "integer",
    default = 1,
    help = "Alpha parameter for the relatedness prior. Default set to 1."
  ),
  make_option(
    "--r_beta",
    type = "integer",
    default = 1,
    help = "Beta parameter for the relatedness prior. Default set to 1."
  ),
  make_option(
    "--mean_coi_shape",
    type = "double",
    default = 0.1,
    help = paste0(
      "Shape parameter for the mean complexity of infection prior. ",
      "Default set to 0.1."
    )
  ),
  make_option(
    "--mean_coi_scale",
    type = "integer",
    default = 10,
    help = paste0(
      "Scale parameter for the mean complexity of infection prior. ",
      "Default set to 10"
    )
  ),
  make_option(
    "--max_eps_pos",
    type = "integer",
    default = 2,
    help = "Maximum value for the positive error rate. Default set to 2."
  ),
  make_option(
    "--max_eps_neg",
    type = "integer",
    default = 2,
    help = "Maximum value for the negative error rate. Default set to 2."
  ),
  make_option(
    "--record_latent_genotypes",
    type = "logical",
    default = FALSE,
    help = paste0(
      "Logical flag to record latent genotypes in the output. ",
      "Default set to FALSE."
    )
  ),
  make_option(
    "--pt_chains",
    type = "integer",
    default = 1,
    help = paste0(
      "Number of chains to run in the parallel tempering process. ",
      "Default set to 1."
    )
  ),
  make_option(
    "--pt_grad_lower",
    type = "double",
    default = 0,
    help = paste0(
      "Lower bound for the gradient step size in the parallel tempering process. ",
      "Default set to 0."
    )
  ),
  make_option(
    "--pt_num_threads",
    type = "integer",
    default = 1,
    help = paste0(
      "Number of threads to use in the parallel tempering process. ",
      "Default set to 1."
    )
  ),
  make_option(
    "--adapt_temp",
    type = "logical",
    default = TRUE,
    help = paste0(
      "Logical flag to enable adaptive temperature in the MCMC process. ",
      "Default set to TRUE."
    )
  ),
  make_option(
    "--max_runtime",
    type = "double",
    default = Inf,
    help = "Maximum runtime for the MCMC process. Default set to Inf."
  ),
  make_option(
    "--coi_summary",
    default = "coi_summary.tsv",
    help = paste0(
      "TSV file for COI (complexity of infection) summary. ",
      "This file will contain summarized COI information for each sample."
    )
  ),
  make_option(
    "--he_summary",
    default = "he_summary.tsv",
    help = paste0(
      "TSV file for He (expected heterozygosity) summary. ",
      "This file will provide He values calculated across all loci."
    )
  ),
  make_option(
    "--allele_freq_summary",
    default = "allele_freq_summary.tsv",
    help = paste0(
      "TSV file for allele frequency summary. ",
      "This file will include allele frequencies for all loci."
    )
  ),
  make_option(
    "--relatedness_summary",
    default = "relatedness_summary.tsv",
    help = paste0(
      "TSV file for relatedness summary. ",
      "This file will contain pairwise relatedness estimates for all samples."
    )
  ),
  make_option(
    "--effective_coi_summary",
    default = "effective_coi_summary.tsv",
    help = paste0(
      "TSV file for effective COI summary. ",
      "This file will provide the effective complexity of infection estimates."
    )
  ),
  make_option(
    "--mcmc_results_output",
    help = paste0(
      "Optionally can export the full results of moire, which can be helpful ",
      "for debugging or quality assurance (e.g. checking if MCMC properly converged)"
    )
  ),
  make_option(
    "--convergence_output",
    default = "convergence_diag.tsv",
    help = paste0(
      "TSV file for MCMC convergence diagnostics, with one row per estimated ",
      "parameter and the columns: variable, mean, median, sd, q5, q95, rhat, ",
      "ess_bulk, ess_tail. Default set to convergence_diag.tsv."
    )
  ),
  make_option(
    "--acceptance_rates_output",
    default = NULL,
    help = paste0(
      "Optional TSV file for parallel tempering swap (exchange) acceptance ",
      "rates, with one row per chain and temperature rung and the columns: ",
      "chain, rung, temperature, swap_acceptance_rate. Only meaningful when ",
      "parallel tempering is used (--pt_chains > 1)."
    )
  )
)

parser <- OptionParser(option_list = opts)
arg <- parse_args(parser)
if (is.null(arg$allele_table)) {
  stop("Missing the following arguments: --allele_table", call. = FALSE)
}

invisible(
  moire_wrapper(
    allele_table = arg$allele_table,
    allow_relatedness = arg$allow_relatedness,
    burnin = arg$burnin,
    samples_per_chain = arg$samples_per_chain,
    num_chains = arg$num_chains,
    chains_num_threads = arg$chains_num_threads,
    thin = arg$thin,
    verbose = arg$verbose,
    eps_pos_alpha = arg$eps_pos_alpha,
    eps_pos_beta = arg$eps_pos_beta,
    eps_neg_alpha = arg$eps_neg_alpha,
    eps_neg_beta = arg$eps_neg_beta,
    r_alpha = arg$r_alpha,
    r_beta = arg$r_beta,
    mean_coi_shape = arg$mean_coi_shape,
    mean_coi_scale = arg$mean_coi_scale,
    max_eps_pos = arg$max_eps_pos,
    max_eps_neg = arg$max_eps_neg,
    record_latent_genotypes = arg$record_latent_genotypes,
    pt_chains = arg$pt_chains,
    pt_grad_lower = arg$pt_grad_lower,
    pt_num_threads = arg$pt_num_threads,
    adapt_temp = arg$adapt_temp,
    max_runtime = arg$max_runtime,
    coi_summary = arg$coi_summary,
    he_summary = arg$he_summary,
    allele_freq_summary = arg$allele_freq_summary,
    relatedness_summary = arg$relatedness_summary,
    effective_coi_summary = arg$effective_coi_summary,
    mcmc_results_output = arg$mcmc_results_output,
    convergence_output = arg$convergence_output,
    acceptance_rates_output = arg$acceptance_rates_output
  )
)
